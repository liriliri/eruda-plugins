{
  "name": "eruda-plugins",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo of Eruda plugins",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "ci": "npm run ci --workspaces --if-present",
    "dev:features": "npm run dev --workspace=eruda-features",
    "dev:monitor": "npm run dev --workspace=eruda-monitor",
    "dev:benchmark": "npm run dev --workspace=eruda-benchmark",
    "dev:geolocation": "npm run dev --workspace=eruda-geolocation",
    "dev:timing": "npm run dev --workspace=eruda-timing",
    "dev:code": "npm run dev --workspace=eruda-code",
    "dev:orientation": "npm run dev --workspace=eruda-orientation",
    "dev:touches": "npm run dev --workspace=eruda-touches"
  },
  "keywords": [
    "eruda",
    "plugin",
    "monorepo"
  ],
  "author": "surunzi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/eruda-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/liriliri/eruda-plugins/issues"
  },
  "homepage": "https://github.com/liriliri/eruda-plugins#readme",
  "devDependencies": {
    "@babel/core": "^7.21.3",
    "@babel/plugin-transform-runtime": "^7.21.0",
    "@babel/preset-env": "^7.20.2",
    "@babel/runtime": "^7.27.6",
    "autoprefixer": "^10.4.14",
    "babel-loader": "^9.1.2",
    "css-loader": "^3.4.2",
    "eruda": "^3.2.0",
    "es-check": "^7.2.1",
    "eslint": "^8.57.0",
    "licia": "^1.41.1",
    "postcss": "^8.4.21",
    "postcss-class-prefix": "^0.3.0",
    "postcss-loader": "^7.0.2",
    "prettier": "^3.3.3",
    "sass": "^1.77.8",
    "sass-loader": "^16.0.2",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.12.0"
  }
}
